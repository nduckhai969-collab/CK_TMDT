# ===== Firebase Admin SDK (server) =====
# Cách 1 (khuyên dùng khi chạy local): đường dẫn tới file service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Cách 2 (khi deploy): dán nguyên JSON service account vào 1 dòng
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Web API Key (Project settings > General > Web API Key) - dùng cho đổi mật khẩu
FIREBASE_WEB_API_KEY=

# Origin được phép gọi API, cách nhau bởi dấu phẩy (để trống = cho phép tất cả khi dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:63342

# Mật khẩu tạm cho tài khoản mẫu khi chạy: npm run seed
SEED_DEFAULT_PASSWORD=SkillRental@123
PORT=3000

# ===== VNPay Sandbox (nạp ví + thanh toán đơn hàng) =====
# Lấy TMN code và Hash secret khi đăng ký merchant sandbox của VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Phải là địa chỉ mà VNPay gọi về được (khi deploy: https://tên-miền-của-bạn/api/payments/vnpay/return)
# VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
# Số phút liên kết thanh toán trên cổng VNPay còn hiệu lực (mặc định 15)
# VNPAY_EXPIRE_MINUTES=15
# Số phút khách có để thanh toán đơn qua VNPay trước khi đơn tự hủy và nhả khung giờ (mặc định 30)
# ORDER_PAYMENT_WINDOW_MINUTES=30
@@ -14,10 +14,14 @@ CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:63342
 SEED_DEFAULT_PASSWORD=SkillRental@123
 PORT=3000
 
